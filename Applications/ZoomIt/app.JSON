{
  "Application": {
    "Name": "ZoomIt",
    "Publisher": "Microsoft",
    "Version": "v12.1",
    "Category": "Utilities",
    "Description": "ZoomIt"
  },
  "Source": {
    "SetupFile": "Install.ps1",
    "PackageFolder": "Package",
    "SourceFolder": "Source"
  },
  "Install": {
    "Command": "powershell.exe -ExecutionPolicy Bypass -File Install.ps1",
    "UninstallCommand": "powershell.exe -ExecutionPolicy Bypass -File Uninstall.ps1",
    "Context": "System",
    "RestartBehavior": "Suppress"
  },
  "Detection": {
    "Type": "PowerShell",
    "Script": "Detection.ps1"
  },
  "Requirements": {
    "Architecture": "AllWithARM64",
    "MinimumSupportedWindowsRelease": "W11_22H2"
  },
  "Deployment": {
    "AssignmentGroup": "APP-ZoomIt-Required",
    "Ring": "Pilot",
    "Intent": "Required"
  }
}
